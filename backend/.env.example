PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=orbit_db
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
ADMIN_REGISTRATION_CODE=replace_with_a_private_admin_invitation_code
CORS_ORIGIN=http://localhost:5173
# Windows: scheduler/scheduler.exe after compiling with MinGW
# Linux/macOS: scheduler/scheduler after compiling with gcc
# SCHEDULER_PATH=../scheduler/scheduler.exe

# Optional override; default is ../scheduler/deadlock.exe on Windows
# DEADLOCK_PATH=../scheduler/deadlock.exe
